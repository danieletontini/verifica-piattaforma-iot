-- Modello di robustezza della piattaforma IoT per la building automation
-- Passo 1: versione astratta
-- Ogni componente puo' essere: ok, guasto (guasto silenzioso), compromesso (guasto bizantino)
-- Al massimo un componente alla volta non e' ok
-- Una funzione del sistema e' disponibile se nessuno dei componenti necessari e' guasto
-- Il database e' incluso nel Core; gli agent del dispositivo sono inclusi nel device

MODULE main

VAR

device          : componente;   -- dispositivo (Logic Machine)
stt_agent       : componente;   -- agent del device che pubblica stato e telemetria (StateTelemetryAgent)
knx_listener    : componente;   -- agent del device che inoltra gli eventi del bus KNX
command_agent   : componente;   -- agent del device che esegue i comandi
gateway         : componente;   -- gateway KNX/IP
broker          : componente;   -- broker MQTT
core            : componente;   -- Core con il suo database
redis           : componente;   -- Redis
state_agent     : componente;   -- agent del core che scrive lo stato del dispositivo in Redis
response_agent  : componente;   -- agent del core che riceve l'esito dei comandi
event_agent     : componente;   -- agent del core che riceve gli eventi KNX
telemetry_agent : componente;   -- agent del core che riceve la telemetria
reverb          : componente;   -- server WebSocket per il tempo reale
provisioner     : componente;   -- consegna le credenziali ai device
license_mgr     : componente;   -- License Manager
pannello        : componente;   -- pannello web nel browser

-- ipotesi di guasto: al massimo un componente non e' ok
INVAR
  toint(device.stato != ok) + toint(pannello.stato != ok) + toint(stt_agent.stato != ok) + toint(knx_listener.stato != ok)
  + toint(command_agent.stato != ok) + toint(gateway.stato != ok) + toint(broker.stato != ok)
  + toint(core.stato != ok) + toint(redis.stato != ok) + toint(state_agent.stato != ok)
  + toint(response_agent.stato != ok) + toint(event_agent.stato != ok) + toint(telemetry_agent.stato != ok)
  + toint(reverb.stato != ok) + toint(provisioner.stato != ok) + toint(license_mgr.stato != ok) <= 1;

-- funzioni del sistema

-- F1 comando: pannello -> Core -> broker -> device (CommandAgent) -> gateway -> bus KNX
DEFINE comando_ok := pannello.stato != guasto & core.stato != guasto & broker.stato != guasto
                   & device.stato != guasto & gateway.stato != guasto & command_agent.stato != guasto;

-- F2 conferma della configurazione inviata ai device: (file JSON: utenti, zone, template):
-- Core (invio) -> broker -> device (CommandAgent) -> broker -> response_agent -> Redis -> Core (RedisCommandResponses)
DEFINE esito_ok := core.stato != guasto & device.stato != guasto & broker.stato != guasto & response_agent.stato != guasto
                 & redis.stato != guasto & command_agent.stato != guasto;

-- F3 stato del dispositivo: device -> broker -> state_agent -> Redis -> Core -> pannello
DEFINE stato_visibile := device.stato != guasto & broker.stato != guasto & state_agent.stato != guasto
                       & redis.stato != guasto & core.stato != guasto & pannello.stato != guasto & stt_agent.stato != guasto;

-- F4 valore degli item: bus KNX -> gateway -> device (KNX listener) -> broker -> event_agent -> Redis -> Core -> pannello
DEFINE valore_item_ok := gateway.stato != guasto & device.stato != guasto & broker.stato != guasto
                       & event_agent.stato != guasto & redis.stato != guasto & core.stato != guasto
                       & pannello.stato != guasto & knx_listener.stato != guasto;

-- F5 tempo reale: bus KNX -> gateway -> device (KNX listener) -> broker -> event_agent -> Reverb -> pannello
DEFINE tempo_reale_ok := gateway.stato != guasto & device.stato != guasto & broker.stato != guasto
                       & event_agent.stato != guasto & reverb.stato != guasto & pannello.stato != guasto & knx_listener.stato != guasto;

-- F6 moduli installati (telemetria): device -> broker -> telemetry_agent -> Redis -> Core
DEFINE moduli_ok := device.stato != guasto & broker.stato != guasto & telemetry_agent.stato != guasto
                  & redis.stato != guasto & core.stato != guasto & stt_agent.stato != guasto;

-- F7 provisioning: device -> Provisioner -> Core (database) e Provisioner -> broker (dynsec)
DEFINE provisioning_ok := device.stato != guasto & provisioner.stato != guasto & core.stato != guasto
                        & broker.stato != guasto;

-- F8 licenze: Core -> License Manager, OPPURE copia locale delle licenze nel database
DEFINE licenze_ok := core.stato != guasto
                   & (license_mgr.stato != guasto | copia_locale_valida);

-- copia locale delle licenze: per ora sempre valida (da rendere variabile nei passi successivi)
DEFINE copia_locale_valida := TRUE;

--======= DEVICE =======--

-- criticita': se il device si guasta, i comandi non sono disponibili
CTLSPEC
AG (device.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & comando_ok)

-- criticita': se il device si guasta, l'esito dei comandi non e' disponibile
CTLSPEC
AG (device.stato = guasto -> !esito_ok)

-- tolleranza: l'esito dei comandi puo' funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & esito_ok)

-- criticita': se il device si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (device.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & stato_visibile)

-- criticita': se il device si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (device.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & valore_item_ok)

-- criticita': se il device si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (device.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & tempo_reale_ok)

-- criticita': se il device si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (device.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & moduli_ok)

-- criticita': se il device si guasta, il provisioning non e' disponibile
CTLSPEC
AG (device.stato = guasto -> !provisioning_ok)

-- tolleranza: il provisioning puo' funzionare con il device guasto
CTLSPEC
EF (device.stato = guasto & provisioning_ok)


--======= STT_AGENT (StateTelemetryAgent del device) =======--

-- criticita': se lo stt_agent si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (stt_agent.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con lo stt_agent guasto
CTLSPEC
EF (stt_agent.stato = guasto & stato_visibile)

-- criticita': se lo stt_agent si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (stt_agent.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con lo stt_agent guasto
CTLSPEC
EF (stt_agent.stato = guasto & moduli_ok)

-- criticita': se lo stt_agent si guasta, i comandi non sono disponibili (atteso falso)
CTLSPEC
AG (stt_agent.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con lo stt_agent guasto (il device risulta offline, ma i comandi arrivano)
CTLSPEC
EF (stt_agent.stato = guasto & comando_ok)


--======= KNX_LISTENER =======--

-- criticita': se il knx_listener si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (knx_listener.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il knx_listener guasto
CTLSPEC
EF (knx_listener.stato = guasto & valore_item_ok)

-- criticita': se il knx_listener si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (knx_listener.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il knx_listener guasto
CTLSPEC
EF (knx_listener.stato = guasto & tempo_reale_ok)

-- criticita': se il knx_listener si guasta, i comandi non sono disponibili (atteso falso)
CTLSPEC
AG (knx_listener.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il knx_listener guasto (la luce cambia, ma il pannello non lo vede)
CTLSPEC
EF (knx_listener.stato = guasto & comando_ok)


--======= COMMAND_AGENT =======--

-- criticita': se il command_agent si guasta, i comandi non sono disponibili
CTLSPEC
AG (command_agent.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il command_agent guasto
CTLSPEC
EF (command_agent.stato = guasto & comando_ok)

-- criticita': se il command_agent si guasta, la conferma della configurazione non e' disponibile
CTLSPEC
AG (command_agent.stato = guasto -> !esito_ok)

-- tolleranza: la conferma della configurazione puo' funzionare con il command_agent guasto
CTLSPEC
EF (command_agent.stato = guasto & esito_ok)

-- criticita': se il command_agent si guasta, lo stato del dispositivo non e' disponibile (atteso falso)
CTLSPEC
AG (command_agent.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il command_agent guasto (il device risulta online, ma i comandi non arrivano)
CTLSPEC
EF (command_agent.stato = guasto & stato_visibile)

--======= GATEWAY =======--

-- criticita': se il gateway si guasta, i comandi non sono disponibili
CTLSPEC
AG (gateway.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il gateway guasto
CTLSPEC
EF (gateway.stato = guasto & comando_ok)

-- criticita': se il gateway si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (gateway.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il gateway guasto
CTLSPEC
EF (gateway.stato = guasto & valore_item_ok)

-- criticita': se il gateway si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (gateway.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il gateway guasto
CTLSPEC
EF (gateway.stato = guasto & tempo_reale_ok)

-- criticita': se il gateway si guasta, lo stato del dispositivo non e' disponibile (atteso falso)
CTLSPEC
AG (gateway.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il gateway guasto (il device risulta online anche se il gateway KNX e' giu')
CTLSPEC
EF (gateway.stato = guasto & stato_visibile)


--======= BROKER =======--

-- criticita': se il broker si guasta, i comandi non sono disponibili
CTLSPEC
AG (broker.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & comando_ok)

-- criticita': se il broker si guasta, l'esito dei comandi non e' disponibile
CTLSPEC
AG (broker.stato = guasto -> !esito_ok)

-- tolleranza: l'esito dei comandi puo' funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & esito_ok)

-- criticita': se il broker si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (broker.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & stato_visibile)

-- criticita': se il broker si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (broker.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & valore_item_ok)

-- criticita': se il broker si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (broker.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & tempo_reale_ok)

-- criticita': se il broker si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (broker.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & moduli_ok)

-- criticita': se il broker si guasta, il provisioning non e' disponibile
CTLSPEC
AG (broker.stato = guasto -> !provisioning_ok)

-- tolleranza: il provisioning puo' funzionare con il broker guasto
CTLSPEC
EF (broker.stato = guasto & provisioning_ok)


--======= CORE =======--

-- criticita': se il Core si guasta, i comandi non sono disponibili
CTLSPEC
AG (core.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & comando_ok)

-- criticita': se il Core si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (core.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & stato_visibile)

-- criticita': se il Core si guasta, la conferma della configurazione non e' disponibile
CTLSPEC
AG (core.stato = guasto -> !esito_ok)

-- tolleranza: la conferma della configurazione puo' funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & esito_ok)

-- criticita': se il Core si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (core.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & valore_item_ok)

-- criticita': se il Core si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (core.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & moduli_ok)

-- criticita': se il Core si guasta, il provisioning non e' disponibile
CTLSPEC
AG (core.stato = guasto -> !provisioning_ok)

-- tolleranza: il provisioning puo' funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & provisioning_ok)

-- criticita': se il Core si guasta, le licenze non sono disponibili
CTLSPEC
AG (core.stato = guasto -> !licenze_ok)

-- tolleranza: le licenze possono funzionare con il Core guasto
CTLSPEC
EF (core.stato = guasto & licenze_ok)

-- criticita': se il Core si guasta, gli aggiornamenti in tempo reale non sono disponibili (atteso falso)
CTLSPEC
AG (core.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il Core guasto (Reverb riceve gli eventi dall'event_agent, non dal Core)
CTLSPEC
EF (core.stato = guasto & tempo_reale_ok)


--======= REDIS =======--

-- criticita': se Redis si guasta, l'esito dei comandi non e' disponibile
CTLSPEC
AG (redis.stato = guasto -> !esito_ok)

-- tolleranza: l'esito dei comandi puo' funzionare con Redis guasto
CTLSPEC
EF (redis.stato = guasto & esito_ok)

-- criticita': se Redis si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (redis.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con Redis guasto
CTLSPEC
EF (redis.stato = guasto & stato_visibile)

-- criticita': se Redis si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (redis.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con Redis guasto
CTLSPEC
EF (redis.stato = guasto & valore_item_ok)

-- criticita': se Redis si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (redis.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con Redis guasto
CTLSPEC
EF (redis.stato = guasto & moduli_ok)

-- criticita': se Redis si guasta, i comandi non sono disponibili (atteso falso)
CTLSPEC
AG (redis.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con Redis guasto (da verificare con prova: cache di Laravel, controllo della licenza)
CTLSPEC
EF (redis.stato = guasto & comando_ok)

-- criticita': se Redis si guasta, gli aggiornamenti in tempo reale non sono disponibili (atteso falso)
CTLSPEC
AG (redis.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con Redis guasto (l'event_agent invia a Reverb indipendentemente da Redis)
CTLSPEC
EF (redis.stato = guasto & tempo_reale_ok)


--======= STATE_AGENT =======--

-- criticita': se lo state_agent si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (state_agent.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con lo state_agent guasto
CTLSPEC
EF (state_agent.stato = guasto & stato_visibile)


--======= RESPONSE_AGENT =======--

-- criticita': se il response_agent si guasta, l'esito dei comandi non e' disponibile
CTLSPEC
AG (response_agent.stato = guasto -> !esito_ok)

-- tolleranza: l'esito dei comandi puo' funzionare con il response_agent guasto
CTLSPEC
EF (response_agent.stato = guasto & esito_ok)


--======= EVENT_AGENT =======--

-- criticita': se l'event_agent si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (event_agent.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con l'event_agent guasto
CTLSPEC
EF (event_agent.stato = guasto & valore_item_ok)

-- criticita': se l'event_agent si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (event_agent.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con l'event_agent guasto
CTLSPEC
EF (event_agent.stato = guasto & tempo_reale_ok)


--======= TELEMETRY_AGENT =======--

-- criticita': se il telemetry_agent si guasta, i moduli installati non sono disponibili
CTLSPEC
AG (telemetry_agent.stato = guasto -> !moduli_ok)

-- tolleranza: i moduli installati possono funzionare con il telemetry_agent guasto
CTLSPEC
EF (telemetry_agent.stato = guasto & moduli_ok)


--======= REVERB =======--

-- criticita': se Reverb si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (reverb.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con Reverb guasto
CTLSPEC
EF (reverb.stato = guasto & tempo_reale_ok)

-- criticita': se Reverb si guasta, il valore degli item non e' disponibile (atteso falso)
CTLSPEC
AG (reverb.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con Reverb guasto (il valore all'apertura arriva da Redis, non da Reverb)
CTLSPEC
EF (reverb.stato = guasto & valore_item_ok)


--======= PROVISIONER =======--

-- criticita': se il Provisioner si guasta, il provisioning non e' disponibile
CTLSPEC
AG (provisioner.stato = guasto -> !provisioning_ok)

-- tolleranza: il provisioning puo' funzionare con il Provisioner guasto
CTLSPEC
EF (provisioner.stato = guasto & provisioning_ok)

-- criticita': se il Provisioner si guasta, i comandi non sono disponibili (atteso falso)
CTLSPEC
AG (provisioner.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il Provisioner guasto (i device gia' connessi non hanno bisogno del Provisioner)
CTLSPEC
EF (provisioner.stato = guasto & comando_ok)

-- criticita': se il Provisioner si guasta, lo stato del dispositivo non e' disponibile (atteso falso)
CTLSPEC
AG (provisioner.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il Provisioner guasto (lo stato arriva dal device gia' connesso)
CTLSPEC
EF (provisioner.stato = guasto & stato_visibile)


--======= LICENSE_MGR =======--

-- criticita': se il License Manager si guasta, le licenze non sono disponibili (atteso falso)
CTLSPEC
AG (license_mgr.stato = guasto -> !licenze_ok)

-- tolleranza: le licenze possono funzionare con il License Manager guasto (grazie alla copia locale)
CTLSPEC
EF (license_mgr.stato = guasto & licenze_ok)

-- criticita': se il License Manager si guasta, i comandi non sono disponibili (atteso falso)
CTLSPEC
AG (license_mgr.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il License Manager guasto (il controllo della licenza usa la copia locale)
CTLSPEC
EF (license_mgr.stato = guasto & comando_ok)


--======= PANNELLO =======--

-- criticita': se il pannello si guasta, i comandi non sono disponibili
CTLSPEC
AG (pannello.stato = guasto -> !comando_ok)

-- tolleranza: i comandi possono funzionare con il pannello guasto
CTLSPEC
EF (pannello.stato = guasto & comando_ok)

-- criticita': se il pannello si guasta, lo stato del dispositivo non e' disponibile
CTLSPEC
AG (pannello.stato = guasto -> !stato_visibile)

-- tolleranza: lo stato del dispositivo puo' funzionare con il pannello guasto
CTLSPEC
EF (pannello.stato = guasto & stato_visibile)

-- criticita': se il pannello si guasta, il valore degli item non e' disponibile
CTLSPEC
AG (pannello.stato = guasto -> !valore_item_ok)

-- tolleranza: il valore degli item puo' funzionare con il pannello guasto
CTLSPEC
EF (pannello.stato = guasto & valore_item_ok)

-- criticita': se il pannello si guasta, gli aggiornamenti in tempo reale non sono disponibili
CTLSPEC
AG (pannello.stato = guasto -> !tempo_reale_ok)

-- tolleranza: gli aggiornamenti in tempo reale possono funzionare con il pannello guasto
CTLSPEC
EF (pannello.stato = guasto & tempo_reale_ok)



-- MODELLO DEL COMPONENTE:
-- lo stato cambia in modo non deterministico (i guasti possono comparire e sparire in qualunque momento)

MODULE componente

VAR
stato : {ok, guasto, compromesso};

ASSIGN

init(stato) := ok;
next(stato) := {ok, guasto, compromesso};