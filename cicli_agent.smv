-- Modello dei cicli di vita degli agent del device nella piattaforma IoT per la building automation
-- Tesi di laurea triennale - Daniele Tontini
-- Il focus e' la ripresa dopo un guasto: quando un componente smette di funzionare e poi torna,
-- gli agent del device tornano operativi da soli, oppure possono restare bloccati?
--
-- Componenti:
--   device          = dispositivo (Logic Machine) su cui girano gli agent
--   command_agent   = agent del device che esegue i comandi (CommandAgent)
--   stt_agent       = agent del device che pubblica stato e telemetria (StateTelemetryAgent)
--   knx_listener    = agent del device che inoltra al broker gli eventi del bus KNX
--   provisioner     = consegna agli agent le credenziali MQTT
--   core            = Core con il suo database
--   broker          = broker MQTT
--   gateway         = gateway KNX/IP
--   gestore_riavvio = componente a bordo che riceve ed esegue il riavvio da remoto
--
-- Ingressi ambientali:
--   lo stato di ogni componente (funzionante, guasto, compromesso) e' libero:
--   i guasti possono comparire e sparire in qualunque momento
--   riavvio_remoto = scenario scelto all'inizio e mai modificato (FROZENVAR)
--
-- Ipotesi:
--   modello di guasto: guasto = guasto silenzioso (il componente non risponde);
--   compromesso = guasto bizantino, che per ora si comporta come funzionante
--   al massimo due componenti non funzionanti alla volta (INVAR)
--   ogni componente prima o poi torna a funzionare (JUSTICE)
--   le fasi degli agent sono ricavate dallo switch dei rispettivi main.php
--   lo stato BOOT e' omesso: fa solo una stampa e passa subito a CLOUD_SYNC
--   i tempi di attesa (sleep) non sono modellati: restare nella stessa fase per un passo
--   equivale ad aspettare e riprovare
--   il contatore MAX_MQTT_RETRY e' sostituito da una scelta non deterministica,
--   che copre ogni valore del contatore
--   il device e' gia' registrato: non e' modellato il primo provisioning,
--   in cui il Provisioner crea l'utente MQTT sul broker
--   il riavvio da remoto e' un meccanismo previsto, non ancora implementato:
--   si assume che lo esegua un componente a bordo distinto dagli agent (da chiarire con il tutor)
--   Estensioni previste: primo provisioning; perdita rilevata o silenziosa del tunnel KNX;
--   messaggi persi o alterati; unione con robustezza.smv
--
-- Le proprieta' sono numerate per categoria (C = controllo del modello, R = ripresa,
-- B = stallo, D = dipendenze, I = situazioni ingannevoli, RR = riavvio da remoto);
-- per ognuna sono indicati cosa verifica e il risultato atteso
-- Le proprieta' del singolo agent sono scritte solo per command_agent: stt_agent usa
-- lo stesso ciclo e dipende dagli stessi componenti, quindi i risultati sono identici
-- (simmetria, come per a, b, c nel modello del treno)


--======= MODELLO DEL COMPONENTE =======--
-- stampo per i componenti che hanno solo uno stato: device, Provisioner, Core, broker,
-- gateway, gestore del riavvio
MODULE componente

VAR
-- stato del componente
--   funzionante = risponde correttamente
--   guasto      = non risponde (guasto silenzioso)
--   compromesso = risponde in modo scorretto (guasto bizantino)
stato : {funzionante, guasto, compromesso};

ASSIGN
init(stato) := funzionante;                         -- all'avvio tutto funziona

next(stato) := {funzionante, guasto, compromesso};  -- i guasti compaiono e spariscono liberamente


--======= MODELLO DEL CICLO DEGLI AGENT =======--
-- ciclo identico per CommandAgent e StateTelemetryAgent (verificato sui due main.php)
MODULE ciclo_agent(device, provisioner, core, broker, riavvio_remoto, gestore_riavvio)

VAR
-- stato del processo dell'agent
--   funzionante = in esecuzione
--   guasto      = bloccato o terminato
--   compromesso = in esecuzione ma con comportamento scorretto
stato : {funzionante, guasto, compromesso};

-- fase del ciclo (stato dello switch in main.php)
--   provisioning = CLOUD_SYNC:   richiede le credenziali al Provisioner
--   connessione  = MQTT_CONNECT: si connette al broker
--   operativo    = RUN:          scambia messaggi con il broker
fase  : {provisioning, connessione, operativo};

DEFINE
-- vero quando la catena del riavvio da remoto e' disponibile: il Core rileva il blocco
-- e invia il comando, il broker lo consegna, il gestore a bordo lo esegue
puo_essere_riavviato := riavvio_remoto & broker.stato != guasto
                      & core.stato != guasto & gestore_riavvio.stato != guasto;

ASSIGN
init(stato) := funzionante;   -- il processo parte in esecuzione
init(fase)  := provisioning;  -- la prima cosa che fa e' chiedere le credenziali

next(stato) :=
  case

  -- BLOCCATO
     stato = guasto & puo_essere_riavviato                 : {guasto, funzionante};  -- il riavvio da remoto puo' arrivare
     stato = guasto                                        : guasto;                 -- nessuno puo' riavviarlo

  TRUE                                                     : {funzionante, guasto, compromesso};  -- altrimenti lo stato e' libero
  esac;

next(fase) :=
  case

  -- RIAVVIO (del device o del processo: si riparte da BOOT)
     device.stato = guasto | stato = guasto                : provisioning;

  -- PROVISIONING (getCredentials al Provisioner, che interroga il Core)
     fase = provisioning & provisioner.stato != guasto
                         & core.stato != guasto            : connessione;   -- credenziali ottenute
     fase = provisioning                                   : provisioning;  -- fallito: riprova dopo 10 s

  -- CONNESSIONE (al broker)
     fase = connessione & broker.stato != guasto           : operativo;     -- connesso
     fase = connessione                                    : {connessione, provisioning};  -- riprova dopo 5 s, o tentativi finiti

  -- OPERATIVO
     fase = operativo & broker.stato = guasto              : provisioning;  -- errore: torna al provisioning

  TRUE                                                     : fase;          -- resta nella fase attuale
  esac;


--======= MODELLO DEL CICLO DEL KNX LISTENER =======--
-- stesso ciclo degli altri agent, con una differenza in RUN: il listener apre un tunnel
-- KNXnet/IP verso il gateway (KnxListener.php)
-- l'ingresso in RUN comprende l'apertura del tunnel: se il gateway e' guasto, connect() fallisce
-- e si torna al provisioning (catch esterno) senza essere mai stati operativi
-- un guasto del gateway durante RUN non cambia la fase (try interno): lo rappresenta collegamento_knx
MODULE ciclo_knx_listener(device, provisioner, core, broker, gateway, riavvio_remoto, gestore_riavvio)

VAR
-- stato del processo del listener
--   funzionante = in esecuzione
--   guasto      = bloccato o terminato
--   compromesso = in esecuzione ma con comportamento scorretto
stato            : {funzionante, guasto, compromesso};

-- fase del ciclo (stato dello switch in main.php)
--   provisioning = CLOUD_SYNC:   richiede le credenziali al Provisioner
--   connessione  = MQTT_CONNECT: si connette al broker
--   operativo    = RUN:          tunnel aperto, inoltra gli eventi del bus al broker
fase             : {provisioning, connessione, operativo};

-- tunnel KNXnet/IP (UDP) fra il listener e il gateway
--   attivo = il gateway inoltra i telegrammi del bus al listener
--   perso  = il tunnel non esiste (fuori da RUN) oppure e' caduto
collegamento_knx : {attivo, perso};

DEFINE
-- vero quando la catena del riavvio da remoto e' disponibile: il Core rileva il blocco
-- e invia il comando, il broker lo consegna, il gestore a bordo lo esegue
puo_essere_riavviato := riavvio_remoto & broker.stato != guasto
                      & core.stato != guasto & gestore_riavvio.stato != guasto;

ASSIGN
init(stato)            := funzionante;   -- il processo parte in esecuzione
init(fase)             := provisioning;  -- la prima cosa che fa e' chiedere le credenziali
init(collegamento_knx) := perso;         -- all'avvio il tunnel non c'e' ancora

next(stato) :=
  case

  -- BLOCCATO
     stato = guasto & puo_essere_riavviato                 : {guasto, funzionante};  -- il riavvio da remoto puo' arrivare
     stato = guasto                                        : guasto;                 -- nessuno puo' riavviarlo

  TRUE                                                     : {funzionante, guasto, compromesso};  -- altrimenti lo stato e' libero
  esac;

next(fase) :=
  case

  -- RIAVVIO (del device o del processo: si riparte da BOOT)
     device.stato = guasto | stato = guasto                : provisioning;

  -- PROVISIONING (getCredentials al Provisioner, che interroga il Core)
     fase = provisioning & provisioner.stato != guasto
                         & core.stato != guasto            : connessione;   -- credenziali ottenute
     fase = provisioning                                   : provisioning;  -- fallito: riprova dopo 10 s

  -- CONNESSIONE (al broker, poi apertura del tunnel verso il gateway)
     fase = connessione & broker.stato != guasto
                        & gateway.stato != guasto          : operativo;     -- connesso e tunnel aperto
     fase = connessione & broker.stato != guasto           : provisioning;  -- gateway guasto: connect() fallisce
     fase = connessione                                    : {connessione, provisioning};  -- broker guasto: riprova dopo 5 s, o tentativi finiti

  -- OPERATIVO
     fase = operativo & broker.stato = guasto              : provisioning;  -- catch esterno: torna al provisioning

  TRUE                                                     : fase;          -- resta nella fase attuale (anche con il gateway guasto: try interno)
  esac;

next(collegamento_knx) :=
  case

  -- FUORI DA RUN
     next(fase) != operativo                               : perso;   -- resetStates() chiude il tunnel

  -- INGRESSO IN RUN
     fase != operativo & next(fase) = operativo            : attivo;  -- connect() al gateway riuscito

  -- IN RUN
     collegamento_knx = attivo & gateway.stato = guasto    : perso;   -- il gateway cade con il tunnel aperto
     collegamento_knx = perso & gateway.stato != guasto    : {attivo, perso};  -- il gateway e' tornato: il tunnel puo' riprendersi oppure no
                                                                               -- (perdita rilevata o silenziosa, da raffinare)

  TRUE                                                     : collegamento_knx;  -- altrimenti resta com'e'
  esac;


--======= MAIN =======--
MODULE main

FROZENVAR
riavvio_remoto  : boolean;      -- ipotesi: gli agent del device possono essere riavviati dal cloud;
                                -- NuSMV verifica entrambi gli scenari, con e senza il meccanismo

VAR
device          : componente;   -- dispositivo (Logic Machine)
command_agent   : ciclo_agent(device, provisioner, core, broker, riavvio_remoto, gestore_riavvio);  -- esegue i comandi
stt_agent       : ciclo_agent(device, provisioner, core, broker, riavvio_remoto, gestore_riavvio);  -- pubblica stato e telemetria
knx_listener    : ciclo_knx_listener(device, provisioner, core, broker, gateway, riavvio_remoto, gestore_riavvio);  -- inoltra gli eventi del bus KNX
provisioner     : componente;   -- consegna le credenziali ai device
core            : componente;   -- Core con il suo database
broker          : componente;   -- broker MQTT
gateway         : componente;   -- gateway KNX/IP
gestore_riavvio : componente;   -- riceve ed esegue il riavvio da remoto
                                -- (ipotesi: distinto dagli agent; da chiarire con il tutor)

-- al massimo due componenti non funzionanti alla volta: con uno solo, la dipendenza
-- del riavvio da remoto da broker, Core e gestore non emergerebbe mai
INVAR toint(device.stato != funzionante) + toint(command_agent.stato != funzionante)
    + toint(stt_agent.stato != funzionante) + toint(knx_listener.stato != funzionante)
    + toint(provisioner.stato != funzionante) + toint(core.stato != funzionante)
    + toint(broker.stato != funzionante) + toint(gateway.stato != funzionante)
    + toint(gestore_riavvio.stato != funzionante) <= 2

-- fairness dei componenti: prima o poi tornano a funzionare; senza, i controesempi
-- sarebbero banali (un componente che resta guasto per sempre)
JUSTICE device.stato = funzionante
JUSTICE provisioner.stato = funzionante
JUSTICE core.stato = funzionante
JUSTICE broker.stato = funzionante
JUSTICE gateway.stato = funzionante
JUSTICE gestore_riavvio.stato = funzionante

-- fairness degli agent: se la catena del riavvio resta disponibile, prima o poi il riavvio arriva;
-- senza riavvio da remoto non c'e' nessuna garanzia: un agent bloccato puo' restarlo per sempre
JUSTICE command_agent.stato != guasto | !command_agent.puo_essere_riavviato
JUSTICE stt_agent.stato != guasto     | !stt_agent.puo_essere_riavviato
JUSTICE knx_listener.stato != guasto  | !knx_listener.puo_essere_riavviato


--======= CONTROLLO DEL MODELLO =======--

-- [C1] tunnel solo in RUN: fuori da RUN il tunnel KNX non esiste
--      (atteso vero; se fosse falso, collegamento_knx non sarebbe legato alla fase)
CTLSPEC AG (knx_listener.fase != operativo -> knx_listener.collegamento_knx = perso)


--======= RIPRESA =======--

-- [R1] ripresa dopo un guasto del broker: con il riavvio da remoto, ogni volta che il broker
--      e' guasto il CommandAgent prima o poi torna operativo
--      (atteso falso: se i componenti vanno e vengono, l'agent li rincorre per sempre;
--       limitata allo scenario con riavvio: senza, sarebbe falsa per il motivo banale
--       dell'agent bloccato che nessuno riavvia)
CTLSPEC riavvio_remoto -> AG (broker.stato = guasto -> AF command_agent.fase = operativo)

-- [R2] ripresa con stabilita': se prima o poi i componenti smettono di guastarsi,
--      ogni guasto del broker e' seguito dal ritorno del CommandAgent a operativo
--      (atteso vero; LTL perche' l'ipotesi F G riguarda l'intero percorso)
LTLSPEC (F G device.stato = funzionante & F G command_agent.stato = funzionante
       & F G provisioner.stato = funzionante & F G core.stato = funzionante
       & F G broker.stato = funzionante)
        -> G (broker.stato = guasto -> F command_agent.fase = operativo)

-- [R3] riavvio del device: se il device si guasta, al passo dopo il CommandAgent
--      e' in provisioning (atteso vero)
CTLSPEC AG (device.stato = guasto -> AX command_agent.fase = provisioning)

-- [R4] ripresa del tunnel KNX: ogni volta che il collegamento e' perso, prima o poi torna attivo
--      (atteso falso)
CTLSPEC AG (knx_listener.collegamento_knx = perso -> AF knx_listener.collegamento_knx = attivo)


--======= STALLO =======--

-- [B1] stallo nel provisioning: il CommandAgent puo' restare per sempre nel provisioning
--      (atteso vero: Provisioner e Core che si guastano a turno)
CTLSPEC EF EG command_agent.fase = provisioning

-- [B2] stallo nel provisioning con il broker sempre funzionante
--      (atteso vero: il blocco dipende da Provisioner e Core, non dal broker)
CTLSPEC EF EG (broker.stato = funzionante & command_agent.fase = provisioning)


--======= DIPENDENZE =======--

-- [D1] dipendenza nascosta dal Provisioner: con il broker funzionante, se il Provisioner
--      e' guasto il CommandAgent in provisioning non riesce a ripartire (atteso vero)
CTLSPEC AG ((command_agent.fase = provisioning & broker.stato = funzionante
            & provisioner.stato = guasto) -> AX command_agent.fase = provisioning)

-- [D2] dopo la perdita del broker: dopo essere stato operativo e aver perso il broker,
--      il CommandAgent puo' trovarsi fermo al provisioning con il broker tornato
--      funzionante e il Provisioner guasto (atteso vero)
CTLSPEC EF (command_agent.fase = operativo & EX broker.stato = guasto
            & EF (broker.stato = funzionante & provisioner.stato = guasto
                  & command_agent.fase = provisioning))


--======= SITUAZIONI INGANNEVOLI =======--

-- [I1] finestra di rilevamento: quando il CommandAgent e' operativo il broker funziona
--      (atteso falso: l'agent si accorge del guasto solo al passo dopo; nel sistema reale
--       la finestra dura fino al keepalive, 60 s)
CTLSPEC AG (command_agent.fase = operativo -> broker.stato != guasto)

-- [I2] online ma senza comandi: lo StateTelemetryAgent e' operativo (il device risulta online)
--      mentre il CommandAgent non lo e' (atteso vero)
CTLSPEC EF (stt_agent.fase = operativo & command_agent.fase != operativo)

-- [I3] offline ma con i comandi: il CommandAgent e' operativo mentre lo StateTelemetryAgent
--      non lo e' (atteso vero)
CTLSPEC EF (command_agent.fase = operativo & stt_agent.fase != operativo)

-- [I4] disallineamento: listener operativo, gateway funzionante, ma nessun evento dal bus
--      (atteso vero)
CTLSPEC EF (knx_listener.fase = operativo & knx_listener.collegamento_knx = perso
            & gateway.stato = funzionante)

-- [I5] disallineamento permanente: e' possibile arrivare a una situazione in cui, per sempre,
--      il listener e' operativo (in RUN, connesso al broker) e il gateway funziona,
--      ma il tunnel KNX e' perso: nessun telegramma del bus arriva piu' al Core,
--      quindi il pannello non vede i cambiamenti fatti dagli interruttori fisici
--      (atteso vero: dopo un'interruzione del gateway il tunnel puo' non riaprirsi mai)
CTLSPEC EF EG (knx_listener.fase = operativo & knx_listener.collegamento_knx = perso
               & gateway.stato = funzionante)


--======= RIAVVIO DA REMOTO =======--
-- il meccanismo vale per tutti e tre gli agent del device; le proprieta' sono scritte
-- per il CommandAgent, il piu' critico (se si blocca non si possono piu' inviare comandi);
-- per StateTelemetryAgent e KNX listener i risultati sono gli stessi (verificati)
-- riavvio_remoto e' una FROZENVAR: le proprieta' di un solo scenario sono scritte come
-- implicazione sullo stato iniziale, perche' una CTLSPEC deve valere in tutti gli stati iniziali

-- [RR1] blocco definitivo senza riavvio: il CommandAgent puo' bloccarsi e non tornare
--       mai piu' operativo; su quell'impianto non si possono piu' inviare comandi (atteso vero)
CTLSPEC !riavvio_remoto -> EF AG command_agent.fase != operativo

-- [RR2] recuperabilita' con riavvio: da qualunque situazione il CommandAgent puo' sempre
--       tornare operativo (atteso vero)
CTLSPEC riavvio_remoto -> AG EF command_agent.fase = operativo

-- [RR3] recuperabilita' senza riavvio
--       (atteso falso: e' la negazione di [RR1])
CTLSPEC !riavvio_remoto -> AG EF command_agent.fase = operativo

-- [RR4] il riavvio dipende dalla catena: se l'agent e' bloccato e il broker e' guasto,
--       al passo dopo l'agent e' ancora bloccato (atteso vero)
CTLSPEC riavvio_remoto -> AG ((command_agent.stato = guasto & broker.stato = guasto)
                              -> AX command_agent.stato = guasto)

-- [RR5] blocco permanente con riavvio: anche con il broker funzionante, l'agent puo' restare
--       bloccato per sempre se Core e gestore del riavvio si guastano a turno (atteso vero)
CTLSPEC riavvio_remoto -> EF EG (command_agent.stato = guasto & broker.stato = funzionante)
