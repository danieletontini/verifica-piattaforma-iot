-- Modello base della piattaforma IoT per la building automation: accensione di una luce
-- Tesi di laurea triennale - Daniele Tontini
-- Il focus e' un'unica azione, seguita lungo tutta la piattaforma: l'utente accende o spegne
-- una luce dal pannello, e il pannello mostra lo stato della luce.
-- Unisce i due modelli precedenti: i punti critici (robustezza.smv) e il ciclo di
-- riconnessione degli agent del device (cicli_agent.smv). 
--
-- Componenti:
--   pannello        = pannello web nel browser: invia i comandi e mostra lo stato della luce
--   core            = Core (applicazione Laravel con il suo database)
--   broker          = broker MQTT
--   device          = dispositivo (Logic Machine) su cui girano gli agent
--   command_agent   = agent del device che esegue i comandi (CommandAgent)
--   knx_listener    = agent del device che inoltra al broker gli eventi del bus KNX
--   gateway         = gateway KNX/IP fra il device e il bus
--   event_agent     = agent del core che riceve gli eventi KNX e li scrive in Redis
--   redis           = Redis: conserva l'ultimo valore della luce letto dal Core
--   provisioner     = consegna agli agent le credenziali MQTT
--
-- Percorsi:
--   comando: pannello -> Core -> broker -> device (CommandAgent) -> gateway -> bus KNX -> luce
--   ritorno: luce -> bus KNX -> gateway -> device (KNX listener) -> broker -> event_agent
--            -> Redis -> Core -> pannello
--
-- Ingressi ambientali:
--   comando        = tasto premuto dall'utente nel pannello in questo passo
--   interruttore   = qualcuno preme l'interruttore fisico in questo passo
--   lo stato di ogni componente (funzionante, guasto, compromesso) e' libero
--   riavvio_remoto = scenario scelto all'inizio e mai modificato (FROZENVAR)
--
-- Ipotesi:
--   modello di guasto: guasto = guasto silenzioso (il componente non risponde);
--   compromesso = guasto bizantino, che per ora si comporta come funzionante
--   al massimo due componenti non funzionanti alla volta (INVAR)
--   ogni componente prima o poi torna a funzionare (JUSTICE)
--   un comando o un evento attraversa tutto il suo percorso in un solo passo: arriva se
--   in quel passo tutti i componenti del percorso sono disponibili, altrimenti e' perso
--   (nessun ritentativo: il Core non ritenta e gli agent usano la sessione pulita)
--   il pannello mostra l'ultimo valore arrivato in Redis: un evento perso non viene
--   recuperato finche' la luce non cambia di nuovo (nessuna rilettura periodica;
--   da chiarire con il tutor)
--   l'interruttore fisico e' collegato al bus KNX (configurazione di produzione):
--   agisce sulla luce anche senza cloud, e il suo telegramma segue il percorso di ritorno
--   se nello stesso passo arrivano un comando e una pressione dell'interruttore, vale il comando
--   i due agent del device hanno lo stesso ciclo (provisioning, connessione, operativo),
--   ricavato dallo switch dei rispettivi main.php; BOOT, attese e contatori sono astratti
--   il riavvio da remoto e' un meccanismo previsto, non ancora implementato: e' un comando
--   come gli altri, quindi lo riceve ed esegue il CommandAgent. Ne segue che il CommandAgent
--   puo' riavviare gli altri agent del device ma non se stesso: se si blocca, non esiste
--   nessun modo di farlo ripartire da remoto (serve un intervento sul posto, non modellato)
--   i componenti sono indipendenti: non e' modellato il guasto di una macchina che ne
--   ospita piu' di uno (es. Core e Redis sullo stesso server; da chiarire con il tutor)
--   Estensioni previste: vedi le sezioni "DA FARE"
--
-- Le proprieta' sono numerate per categoria (C = controllo del modello, CM = comando,
-- PC = punti critici, AL = allineamento fra luce e pannello, R = ripresa,
-- SA = stallo del CommandAgent, PP = primo provisioning);
-- per ognuna sono indicati cosa verifica e il risultato atteso


--======= MODELLO DEL COMPONENTE =======--
-- stampo per i componenti che hanno solo uno stato
MODULE componente

VAR
-- stato del componente
--   funzionante = risponde correttamente
--   guasto      = non risponde (guasto silenzioso)
--   compromesso = risponde in modo scorretto (guasto bizantino)
stato : {funzionante, guasto, compromesso};

ASSIGN
init(stato) := funzionante;                         -- all'avvio tutto funziona

next(stato) := {funzionante, guasto, compromesso};  -- i guasti compaiono e spariscono liberamente


--======= MODELLO DEL CICLO DEGLI AGENT =======--
-- ciclo comune agli agent del device (verificato sui main.php)
-- puo_essere_riavviato: vero quando in questo passo un riavvio da remoto puo' raggiungere l'agent
MODULE ciclo_agent(device, provisioner, core, broker, puo_essere_riavviato, utente_mqtt)

VAR
-- stato del processo dell'agent
--   funzionante = in esecuzione
--   guasto      = bloccato o terminato
--   compromesso = in esecuzione ma con comportamento scorretto
stato : {funzionante, guasto, compromesso};

-- fase del ciclo (stato dello switch in main.php)
--   provisioning = CLOUD_SYNC:   richiede le credenziali al Provisioner
--   connessione  = MQTT_CONNECT: si connette al broker
--   operativo    = RUN:          scambia messaggi con il broker
fase  : {provisioning, connessione, operativo};

DEFINE
-- vero quando l'agent puo' ricevere o inviare messaggi in questo passo
pronto := fase = operativo & stato != guasto;

-- vero quando l'agent sta chiedendo le credenziali al Provisioner
richiede_credenziali := fase = provisioning & stato != guasto & device.stato != guasto;

ASSIGN
init(stato) := funzionante;   -- il processo parte in esecuzione
init(fase)  := provisioning;  -- la prima cosa che fa e' chiedere le credenziali

next(stato) :=
  case

  -- BLOCCATO
     stato = guasto & puo_essere_riavviato                 : {guasto, funzionante};  -- il riavvio da remoto puo' arrivare
     stato = guasto                                        : guasto;                 -- nessuno puo' riavviarlo: resta bloccato

  TRUE                                                     : {funzionante, guasto, compromesso};  -- altrimenti lo stato e' libero
  esac;

next(fase) :=
  case

  -- RIAVVIO (del device o del processo: si riparte da BOOT)
     device.stato = guasto | stato = guasto                : provisioning;

  -- PROVISIONING (getCredentials al Provisioner, che interroga il Core)
  -- al primo provisioning serve anche il broker, per creare l'utente MQTT
     fase = provisioning & provisioner.stato != guasto
                         & core.stato != guasto  & (utente_mqtt = presente | broker.stato != guasto)   : connessione;   -- credenziali ottenute
     fase = provisioning                                   : provisioning;  -- fallito: riprova

  -- CONNESSIONE (al broker)
     fase = connessione & broker.stato != guasto           : operativo;     -- connesso
     fase = connessione                                    : {connessione, provisioning};  -- riprova, o tentativi finiti

  -- OPERATIVO
     fase = operativo & broker.stato = guasto              : provisioning;  -- errore: torna al provisioning

  TRUE                                                     : fase;          -- resta nella fase attuale
  esac;



--======= MAIN =======--
MODULE main

FROZENVAR
riavvio_remoto  : boolean;      -- ipotesi: gli agent del device possono essere riavviati dal cloud;
                                -- NuSMV verifica entrambi gli scenari, con e senza il meccanismo

secondo_canale  : boolean;      -- contromisura: e' stato implementato un secondo agent(StateTelemetryAgent)
                                -- in grado di ricevere comandi di riavvio  

scadenza_copia  : boolean;      -- FALSE = dev: la copia locale delle licenze non scade
                                -- TRUE  = in produzione: la copia scade se non viene aggiornata(rinnovata)
VAR
-- ingressi ambientali
--   comando: tasto premuto dall'utente nel pannello in questo passo
--     nessuno = nessun tasto premuto
--     accendi = richiesta di accendere la luce
--     spegni  = richiesta di spegnere la luce
comando         : {nessuno, accendi, spegni};

interruttore    : boolean;      -- qualcuno preme l'interruttore fisico 
comando_modulo  : boolean;      -- si ha necessità di un modulo con licenza 
comando_perso   : boolean;      -- il comando si perde lungo l'andata anche con tutti i componenti funzionanti
                              

-- utente MQTT del device (creato dal Provisioner al primo provisioning)
--   assente  = device registrato nel Core con il suo canale, ma senza credenziali MQTT
--   presente = credenziali salvate nel Core e utente creato sul broker, con i permessi
--              limitati al canale del device
utente_mqtt     : {assente, presente};

-- licenza di un modulo opzionale
licenza_attiva  : boolean;      -- stato vero della licenza sul License Manager (FALSE = revocata)
-- copia locale della licenza nel database del Core
--   valida  = il modulo puo' essere usato
--   scaduta = non aggiornata in tempo, oppure cancellata ("nessuna licenza")
copia_licenza   : {valida, scaduta};

-- la luce
luce_impianto   : boolean;      -- stato vero della luce nell'impianto 
luce_pannello   : boolean;      -- stato della luce mostrato nel pannello (ultimo valore arrivato in Redis)

-- componenti
pannello        : componente;   -- pannello web nel browser
core            : componente;   -- Core con il suo database
broker          : componente;   -- broker MQTT
device          : componente;   -- dispositivo (Logic Machine)
command_agent   : ciclo_agent(device, provisioner, core, broker, riavvio_agent, utente_mqtt);  -- esegue i comandi; non puo' riavviare se stesso
knx_listener    : ciclo_agent(device, provisioner, core, broker, riavvio_agent, utente_mqtt);  -- inoltra gli eventi del bus KNX
stt_agent       : ciclo_agent(device, provisioner, core, broker, riavvio_agent, utente_mqtt);  -- pubblica lo stato online; con il secondo canale riceve anche i riavvii
gateway         : componente;   -- gateway KNX/IP
event_agent     : componente;   -- agent del core che scrive gli eventi KNX in Redis
redis           : componente;   -- Redis
provisioner     : componente;   -- consegna le credenziali agli agent
license_mgr     : componente;   -- License Manager: conosce lo stato vero delle licenze
DEFINE
-- vero quando un comando premuto in questo passo arriva fino alla luce
-- percorso: pannello -> Core -> broker -> device (CommandAgent) -> gateway -> bus KNX
percorso_comando := pannello.stato != guasto & core.stato != guasto & broker.stato != guasto
                  & device.stato != guasto & command_agent.pronto & gateway.stato != guasto;
comando_consegnato := comando != nessuno & percorso_comando & !comando_perso;

-- vero quando un comando per il modulo con licenza arriva al device:
-- stesso percorso del comando della luce, piu' il controllo della copia locale della licenza
-- (il Core controlla la sua copia nel database, non chiede al License Manager a ogni comando)
comando_modulo_consegnato := comando_modulo & percorso_comando & !comando_perso & copia_licenza = valida;


-- vero quando in questo passo un riavvio da remoto puo' raggiungere un agent del device:
-- e' un comando, quindi segue il percorso del comando fino a un agent
-- che riceve i riavvii: il CommandAgent, oppure lo StateTelemetryAgent con il secondo canale
riavvio_agent := riavvio_remoto & pannello.stato != guasto & core.stato != guasto
               & broker.stato != guasto & device.stato != guasto
               & (command_agent.pronto | (secondo_canale & stt_agent.pronto));

-- vero quando un cambiamento della luce in questo passo arriva fino al pannello
-- percorso: bus KNX -> gateway -> device (KNX listener) -> broker -> event_agent -> Redis -> Core -> pannello
evento_consegnato := gateway.stato != guasto & device.stato != guasto & knx_listener.pronto
                   & broker.stato != guasto & event_agent.stato != guasto & redis.stato != guasto
                   & core.stato != guasto & pannello.stato != guasto;

-- il device risulta online: lo StateTelemetryAgent e' connesso al broker
-- (e' l'unico agent con il Last Will: se la connessione cade, il broker pubblica "offline")
device_online := stt_agent.pronto & device.stato != guasto & broker.stato != guasto;

-- vero quando il pannello mostra lo stato vero della luce
allineato := luce_pannello = luce_impianto;

-- vero quando in questo passo avviene il primo provisioning: l'utente non esiste ancora,
-- almeno un agent chiede le credenziali, e Provisioner, Core e broker possono crearlo
primo_provisioning := utente_mqtt = assente
                    & (command_agent.richiede_credenziali | knx_listener.richiede_credenziali | stt_agent.richiede_credenziali)
                    & provisioner.stato != guasto & core.stato != guasto & broker.stato != guasto;



ASSIGN
init(luce_impianto) := FALSE;   -- la luce parte spenta
init(luce_pannello) := FALSE;   -- e il pannello la mostra spenta
init(utente_mqtt)   := assente; -- il device non ha ancora chiesto le credenziali
init(licenza_attiva) := TRUE;   -- all'avvio la licenza e' pagata
init(copia_licenza)  := valida; -- e la copia locale la riporta



next(luce_impianto) :=
  case

  -- COMANDO DAL PANNELLO
     comando = accendi & comando_consegnato   : TRUE;            -- il comando arriva: luce accesa
     comando = spegni  & comando_consegnato   : FALSE;           -- il comando arriva: luce spenta

  -- INTERRUTTORE FISICO
     interruttore                             : !luce_impianto;  -- sul bus KNX: funziona anche senza cloud

  TRUE                                        : luce_impianto;   -- la luce non cambia da sola
  esac;

next(luce_pannello) :=
  case

  -- EVENTO KNX
     next(luce_impianto) != luce_impianto & evento_consegnato : next(luce_impianto);  -- la luce cambia e l'evento arriva
                                                                             -- (se non arriva, l'evento e' perso)

  TRUE                                                  : luce_pannello;     -- il pannello mostra l'ultimo valore ricevuto
  esac;

next(utente_mqtt) :=
   case

  -- primo provisioning
     primo_provisioning                   :     presente;

   TRUE                                   :     utente_mqtt;   -- se esiste gia' rimane quello o se e' assente
   esac;


-- la licenza puo' essere revocata in qualunque momento
next(licenza_attiva) :=
  case

  -- REVOCA
     licenza_attiva                                          : {TRUE, FALSE};  -- resta attiva o viene revocata

  TRUE                                                       : FALSE;          -- gia' revocata: resta revocata
  esac;

-- la copia locale viene aggiornata da licence:retrieve, che il Core esegue
-- interrogando il License Manager
next(copia_licenza) :=
  case

  -- LICENSE MANAGER COMPROMESSO (risponde in modo scorretto)
     license_mgr.stato = compromesso & core.stato != guasto  : {valida, scaduta};  -- puo' dire il falso in entrambi i sensi

  -- LICENSE MANAGER FUNZIONANTE (risponde con lo stato vero della licenza)
     license_mgr.stato = funzionante & core.stato != guasto
                                     & licenza_attiva        : valida;             -- licenza presente: copia aggiornata
     license_mgr.stato = funzionante & core.stato != guasto  : scaduta;            -- "nessuna licenza": copia cancellata (fail-closed)

  -- LICENSE MANAGER NON RAGGIUNGIBILE (o Core guasto: licence:retrieve non gira)
     scadenza_copia & copia_licenza = valida                 : {valida, scaduta};  -- con la scadenza, la copia puo' scadere

  TRUE                                                       : copia_licenza;      -- fail-open: resta la copia locale
  esac;


-- al massimo due componenti non funzionanti alla volta: con uno solo, la dipendenza
-- del riavvio da remoto dal CommandAgent e dal resto del percorso non emergerebbe mai
INVAR toint(pannello.stato != funzionante) + toint(core.stato != funzionante)
    + toint(broker.stato != funzionante) + toint(device.stato != funzionante)
    + toint(command_agent.stato != funzionante) + toint(knx_listener.stato != funzionante)
    + toint(stt_agent.stato != funzionante) + toint(gateway.stato != funzionante) 
    + toint(event_agent.stato != funzionante) + toint(redis.stato != funzionante) 
    + toint(provisioner.stato != funzionante) + toint(license_mgr.stato != funzionante) <= 2

-- fairness dei componenti: prima o poi tornano a funzionare; senza, i controesempi
-- sarebbero banali (un componente che resta guasto per sempre)
JUSTICE pannello.stato = funzionante
JUSTICE core.stato = funzionante
JUSTICE broker.stato = funzionante
JUSTICE device.stato = funzionante
JUSTICE gateway.stato = funzionante
JUSTICE event_agent.stato = funzionante
JUSTICE redis.stato = funzionante
JUSTICE provisioner.stato = funzionante
JUSTICE license_mgr.stato = funzionante
-- fairness dei messaggi: non tutti i comandi si perdono per sempre
JUSTICE !comando_perso

-- fairness degli agent del device: se il riavvio da remoto resta possibile, prima o poi arriva
-- (per il CommandAgent solo con il secondo canale: senza, nessuno puo' farlo ripartire)
JUSTICE command_agent.stato != guasto | !riavvio_agent
JUSTICE knx_listener.stato  != guasto | !riavvio_agent
JUSTICE stt_agent.stato     != guasto | !riavvio_agent


--======= CONTROLLO DEL MODELLO =======--

-- [C1] la luce puo' accendersi con un comando dal pannello (atteso vero)
CTLSPEC EF (comando = accendi & comando_consegnato)

-- [C2] il pannello puo' mostrare la luce accesa quando e' accesa (atteso vero)
CTLSPEC EF (luce_impianto & luce_pannello)

-- [C3] entrambi gli agent possono essere pronti insieme (atteso vero)
CTLSPEC EF (command_agent.pronto & knx_listener.pronto)


--======= COMANDO =======--

-- [CM1] accensione: se il comando accendi viene consegnato, al passo dopo la luce e' accesa
--       (atteso vero)
CTLSPEC AG ((comando = accendi & comando_consegnato) -> AX luce_impianto)

-- [CM2] spegnimento: se il comando spegni viene consegnato, al passo dopo la luce e' spenta
--       (atteso vero)
CTLSPEC AG ((comando = spegni & comando_consegnato) -> AX !luce_impianto)

-- [CM3] nessuna accensione spontanea: senza comando consegnato e senza interruttore,
--       la luce spenta resta spenta (atteso vero)
CTLSPEC AG ((!luce_impianto & !comando_consegnato & !interruttore) -> AX !luce_impianto)

-- [CM4] nessuno spegnimento spontaneo: senza comando consegnato e senza interruttore,
--       la luce accesa resta accesa (atteso vero)
CTLSPEC AG ((luce_impianto & !comando_consegnato & !interruttore) -> AX luce_impianto)

-- [CM5] comando perso: un comando premuto con il pannello funzionante puo' non arrivare
--       (atteso vero: basta un componente del percorso non disponibile; nessuno ritenta)
CTLSPEC EF (comando = accendi & pannello.stato = funzionante & !comando_consegnato)

-- [CM6] interruttore senza cloud: con il broker guasto l'interruttore accende comunque la luce
--       (atteso vero: l'interruttore agisce sul bus KNX)
CTLSPEC AG ((broker.stato = guasto & interruttore & !luce_impianto) -> AX luce_impianto)

-- [CM7] perdita senza guasti: con il percorso del comando disponibile, la luce si accende
--       al passo dopo - safety (AX)
--       (atteso falso: il comando si puo' perdere anche con tutti i componenti funzionanti)
CTLSPEC AG ((comando = accendi & percorso_comando & !luce_impianto) -> AX luce_impianto)

-- [CM8] perdita visibile: se il comando si perde, il pannello resta coerente con la luce
--       - safety (AX)
--       (atteso vero: la luce non cambia e il pannello continua a mostrarla com'e')
CTLSPEC AG ((comando != nessuno & percorso_comando & comando_perso & !interruttore & allineato)
            -> AX allineato)

-- [CM9] il comando si puo' perdere con entrambi i percorsi disponibili e il pannello
--       allineato - raggiungibilita' (atteso vero)
CTLSPEC EF (comando = accendi & percorso_comando & comando_perso & !luce_impianto & allineato)

--======= PUNTI CRITICI DEL COMANDO =======--
-- vero = il componente e' un punto critico: se si guasta, nessun comando arriva alla luce
-- falso = non lo e': il controesempio mostra il componente guasto e il percorso disponibile

-- [PC1] pannello (atteso vero)
CTLSPEC AG (pannello.stato = guasto -> !percorso_comando)

-- [PC2] Core (atteso vero)
CTLSPEC AG (core.stato = guasto -> !percorso_comando)

-- [PC3] broker (atteso vero)
CTLSPEC AG (broker.stato = guasto -> !percorso_comando)

-- [PC4] device (atteso vero)
CTLSPEC AG (device.stato = guasto -> !percorso_comando)

-- [PC5] CommandAgent (atteso vero)
CTLSPEC AG (command_agent.stato = guasto -> !percorso_comando)

-- [PC6] gateway (atteso vero)
CTLSPEC AG (gateway.stato = guasto -> !percorso_comando)

-- [PC7] Provisioner
--       (atteso falso: non e' un punto critico per un CommandAgent gia' operativo;
--        lo diventa durante la ripresa, vedi [R3])
CTLSPEC AG (provisioner.stato = guasto -> !percorso_comando)

-- [PC8] KNX listener
--       (atteso falso: non e' un punto critico per il comando; la luce cambia,
--        ma il pannello non lo vede, vedi [AL1])
CTLSPEC AG (knx_listener.stato = guasto -> !percorso_comando)

-- [PC9] Redis
--       (atteso falso)
CTLSPEC AG (redis.stato = guasto -> !percorso_comando)


--======= ALLINEAMENTO FRA LUCE E PANNELLO =======--

-- [AL1] allineamento: il pannello mostra sempre lo stato vero della luce
--       (atteso falso: se la luce cambia mentre il percorso di ritorno non e' disponibile,
--        l'evento e' perso)
CTLSPEC AG allineato

-- [AL2] conservazione: se il pannello e' allineato e il percorso di ritorno e' disponibile,
--       al passo dopo e' ancora allineato (atteso vero: il disallineamento nasce solo
--       da un evento perso)
CTLSPEC AG ((allineato & evento_consegnato) -> AX allineato)

-- [AL3] comando eseguito ma non visto: un comando accende la luce e il pannello
--       continua a mostrarla spenta (atteso vero)
CTLSPEC EF (comando = accendi & comando_consegnato & !luce_impianto & !evento_consegnato)

-- [AL4] disallineamento permanente: il pannello puo' restare disallineato per sempre,
--       anche con entrambi i percorsi di nuovo disponibili
--       (atteso vero: un evento perso non viene recuperato finche' la luce non cambia di nuovo)
CTLSPEC EF EG (!allineato & percorso_comando & evento_consegnato)

-- [AL5] riallineamento: quando il pannello e' disallineato, prima o poi torna allineato
--       (atteso falso: conseguenza di [AL4])
CTLSPEC AG (!allineato -> AF allineato)


--======= RIPRESA =======--
-- [R1] ripresa con stabilita': se prima o poi i componenti smettono di guastarsi,
--      ogni guasto del broker e' seguito dal ritorno del CommandAgent a operativo
--      (atteso vero; LTL perche' l'ipotesi F G riguarda l'intero percorso)
LTLSPEC (F G device.stato = funzionante & F G command_agent.stato = funzionante
       & F G provisioner.stato = funzionante & F G core.stato = funzionante
       & F G broker.stato = funzionante)
        -> G (broker.stato = guasto -> F command_agent.fase = operativo)

-- [R2] riavvio del device: se il device si guasta, al passo dopo il CommandAgent
--      e' in provisioning (atteso vero)
CTLSPEC AG (device.stato = guasto -> AX command_agent.fase = provisioning)

-- [R3] dipendenza nascosta dal Provisioner: con il broker funzionante, se il Provisioner
--      e' guasto il CommandAgent in provisioning non riesce a ripartire (atteso vero)
CTLSPEC AG ((command_agent.fase = provisioning & broker.stato = funzionante
            & provisioner.stato = guasto) -> AX command_agent.fase = provisioning)


--======= STALLO DEL COMMAND AGENT =======--
-- riavvio_remoto e secondo_canale sono FROZENVAR: le proprieta' di un solo scenario sono
-- scritte come implicazione sullo stato iniziale, perche' una CTLSPEC deve valere in tutti
-- gli stati iniziali
-- senza il secondo canale il CommandAgent e' l'unico agent a bordo che riceve comandi dal cloud:
-- se si blocca, non si puo' piu' comandare la luce ne' riavviare un agent da remoto

-- [SA1] stallo definitivo: una volta che il CommandAgent si blocca, nessun comando arriva
--       piu' alla luce, per sempre (atteso vero, anche con il riavvio da remoto; con il secondo canale vedi [SC1])
CTLSPEC !secondo_canale -> AG (command_agent.stato = guasto -> AG !percorso_comando)

-- [SA2] il CommandAgent non riparte: senza il secondo canale, una volta bloccato resta bloccato
--       (atteso vero: il riavvio da remoto passa dal CommandAgent stesso)
CTLSPEC !secondo_canale -> AG (command_agent.stato = guasto -> AG command_agent.stato = guasto)

-- [SA3] il riavvio da remoto serve agli altri agent: con il CommandAgent pronto,
--       un KNX listener bloccato puo' tornare pronto (atteso vero)
CTLSPEC riavvio_remoto -> EF (knx_listener.stato = guasto & command_agent.pronto & EF knx_listener.pronto)

-- [SA4] senza riavvio da remoto, un KNX listener bloccato resta bloccato (atteso vero)
CTLSPEC !riavvio_remoto -> AG (knx_listener.stato = guasto -> AG knx_listener.stato = guasto)

-- [SA5] stallo doppio: se sono bloccati sia il CommandAgent sia il KNX listener,
--       nemmeno il riavvio da remoto fa ripartire il listener (atteso vero; con il secondo canale vedi [SC3])
CTLSPEC !secondo_canale -> AG ((command_agent.stato = guasto & knx_listener.stato = guasto) -> AG knx_listener.stato = guasto)

-- [SA6] stallo non visibile: con il CommandAgent bloccato il percorso di ritorno puo'
--       funzionare; il pannello continua ad aggiornarsi come se tutto andasse bene (atteso vero)
CTLSPEC EF (command_agent.stato = guasto & evento_consegnato)

-- [SA7] l'interruttore resta: con il CommandAgent bloccato, l'interruttore fisico
--       accende comunque la luce (atteso vero)
CTLSPEC AG ((command_agent.stato = guasto & interruttore & !luce_impianto) -> AX luce_impianto)

-- [SA8] recuperabilita': da qualunque situazione il percorso del comando puo' tornare disponibile
--       (atteso falso: conseguenza di [SA1]; resta falsa anche con il secondo canale,
--        per lo stallo doppio di [SC4])
CTLSPEC AG EF percorso_comando

--======= PRIMO PROVISIONING =======--

-- [PP1] il primo provisioning puo' avvenire, e l'utente viene creato
-- (atteso vero)
CTLSPEC EF primo_provisioning

-- [PP2] verifica che l'utente venga creato
-- (atteso vero)
CTLSPEC EF utente_mqtt = presente

-- [PP3] con il broker guasto il primo provisioning non puo' avvenire
-- (atteso vero)
CTLSPEC AG(broker.stato = guasto -> !primo_provisioning)

-- [PP4] se il broker e' guasto non e' possibile assegnare le credenziali mqtt
-- (atteso vero)
CTLSPEC AG ((utente_mqtt = assente & broker.stato = guasto) -> AX utente_mqtt = assente)

-- [PP5] se il broker e' guasto e non vi sono credenziali mqtt al passo successivo si rimane in provisioning
-- (attesp vero)
CTLSPEC AG ((utente_mqtt = assente & broker.stato = guasto
             & command_agent.fase = provisioning) -> AX command_agent.fase = provisioning)

-- [PP6] senza utente non e' possibile accendere la luce 
-- (atteso vero: per essere pronto l'agent deve aver superato il provisioning)
CTLSPEC AG (utente_mqtt = assente -> !percorso_comando)

-- [PP7] prima o poi l'utente viene creato
-- (atteso vero)
CTLSPEC AG (utente_mqtt = assente -> AF utente_mqtt = presente)




--======= STATO ONLINE =======--

-- [ON1] il device puo' risultare online
-- (atteso vero)
CTLSPEC EF device_online 


-- [ON2] il device puo' risultare online con il CommandAgent guasto
-- (atteso vero: senza il secondo canale il CommandAgent bloccato non riparte; con il
--  secondo canale resta vera solo se il CommandAgent si blocca di nuovo dopo ogni riavvio)
CTLSPEC EF (device_online & command_agent.stato = guasto)

-- [ON3] se il device e' online, i comandi arrivano
-- (atteso falso: online e comandi passano da due agent e due connessioni separate)
CTLSPEC AG (device_online -> percorso_comando)

-- [ON4] stallo: il device puo' restare online per sempre senza ricevere comandi
-- (atteso vero: il CommandAgent guasto non puo' essere riavviato da remoto)
CTLSPEC EF EG (device_online & !percorso_comando)



--======= SECONDO CANALE DI RIAVVIO =======--
-- contromisura implementata: anche lo StateTelemetryAgent riceve i comandi di riavvio
-- (solo quelli: i comandi della luce passano sempre dal CommandAgent)

-- [SC1] con il secondo canale, un CommandAgent bloccato puo' tornare pronto (atteso vero)
CTLSPEC (secondo_canale & riavvio_remoto) -> EF (command_agent.stato = guasto & EF command_agent.pronto)

-- [SC2] puo' farlo sempre, finche' lo StateTelemetryAgent non e' bloccato (atteso vero)
CTLSPEC (secondo_canale & riavvio_remoto)
        -> AG ((command_agent.stato = guasto & stt_agent.stato != guasto) -> EF command_agent.pronto)

-- [SC3] il KNX listener si riprende anche con il CommandAgent bloccato
--       (atteso vero; senza il secondo canale vedi [SA5])
CTLSPEC (secondo_canale & riavvio_remoto)
        -> EF (command_agent.stato = guasto & knx_listener.stato = guasto & EF knx_listener.pronto)

-- [SC4] stallo doppio: se si bloccano entrambi gli agent che ricevono i riavvii,
--       restano bloccati per sempre (atteso vero: serve un intervento sul posto)
CTLSPEC AG ((command_agent.stato = guasto & stt_agent.stato = guasto)
            -> AG (command_agent.stato = guasto & stt_agent.stato = guasto))

-- [SC5] recuperabilita' con il secondo canale: il percorso del comando puo' sempre
--       tornare disponibile? (atteso falso: lo stallo doppio di [SC4])
CTLSPEC (secondo_canale & riavvio_remoto) -> AG EF percorso_comando


--======= LICENZE =======--
-- scadenza_copia e' una FROZENVAR: FALSE = la copia locale non scade,
-- TRUE = la copia scade se non viene aggiornata
-- licenza_attiva = stato vero della licenza; copia_licenza = quello che vede il Core

-- [LI1] correttezza del modello: un comando al modulo con licenza puo' arrivare
--       (atteso vero)
CTLSPEC EF comando_modulo_consegnato

-- [LI2] la luce dipende dal License Manager
--       (atteso falso: il modulo KNX non ha licenza, ma la luce 
--       funziona comunque; il License Manager guasto non blocca il modulo)
CTLSPEC AG (license_mgr.stato = guasto -> !percorso_comando)

-- [LI3] un License Manager guasto non blocca il modulo se la licenza e' tenuta in locale ela copia resta valida
--       (atteso vero)
CTLSPEC !scadenza_copia -> AG ((license_mgr.stato = guasto & copia_licenza = valida)
                               -> AX copia_licenza = valida)

-- [LI4] con la scadenza, License Manager guasto e copia scaduta bloccano il modulo
--       anche con il percorso del comando disponibile (atteso vero)
CTLSPEC scadenza_copia -> EF (license_mgr.stato = guasto & comando_modulo & percorso_comando
                              & !comando_modulo_consegnato)

-- [LI5] al ritorno del License Manager una licenza pagata torna valida (atteso vero)
CTLSPEC AG ((licenza_attiva & license_mgr.stato = funzionante & core.stato != guasto)
            -> AX copia_licenza = valida)


-- revoca della licenza

-- [LI6] la revoca ha effetto subito, se il License Manager e' raggiungibile
--       (atteso vero)
CTLSPEC AG ((!licenza_attiva & license_mgr.stato = funzionante & core.stato != guasto)
            -> AX copia_licenza = scaduta)

-- [LI7] con il License Manager irraggiungibile, la revoca resta senza effetto
--       (atteso vero: la copia locale non scade)
CTLSPEC !scadenza_copia -> AG ((!licenza_attiva & license_mgr.stato = guasto & copia_licenza = valida)
                               -> AX copia_licenza = valida)

-- [LI8] un modulo con la licenza revocata puo' ancora essere usato
--       (atteso vero)
CTLSPEC !scadenza_copia -> EF (!licenza_attiva & license_mgr.stato = guasto & comando_modulo_consegnato)

-- [LI9] con la scadenza, la revoca puo' avere effetto anche senza License Manager
--       (atteso vero: la copia scade)
CTLSPEC scadenza_copia -> AG ((!licenza_attiva & license_mgr.stato = guasto & copia_licenza = valida)
                              -> EX copia_licenza = scaduta)


-- License Manager compromesso:

-- [LI10] puo' disattivare un modulo regolarmente pagato (atteso vero)
CTLSPEC EF (licenza_attiva & license_mgr.stato = compromesso & copia_licenza = valida
            & EX copia_licenza = scaduta)

-- [LI11] puo' riattivare una licenza revocata (atteso vero)
CTLSPEC EF (!licenza_attiva & license_mgr.stato = compromesso & copia_licenza = scaduta
            & EX copia_licenza = valida)


            
--------------------------------------------------------------------------
-- DA FARE: PROPRIETA' DEI PASSI SUCCESSIVI 
--------------------------------------------------------------------------
--   punti critici del ritorno  : AG (x.stato = guasto -> !evento_consegnato), come [PC1]-[PC9]
--   tunnel KNX                 : disallineamento con listener operativo e gateway funzionante
--   comando alterato           : AG ((comando = accendi & comando_consegnato) -> AX luce_impianto)
--                                deve diventare falsa con un componente compromesso sul percorso
--   esito del comando          : il comando eseguito viene sempre confermato al Core?
--   device online nel pannello : online ma senza comandi, offline ma con i comandi
--   riallineamento             : con la rilettura dei valori, [AL4] deve diventare falsa
--
--   licenze (con il modello delle licenze):
--     il guasto del License Manager non blocca subito il modulo:
--       CTLSPEC AG ((license_mgr.stato = guasto & copia_licenza = valida) -> EX copia_licenza = valida)   (atteso vero)
--     ma puo' bloccarlo se dura:
--       CTLSPEC EF (license_mgr.stato = guasto & copia_licenza = scaduta)                                   (atteso vero)
--     al ritorno del License Manager il modulo torna utilizzabile:
--       CTLSPEC AG ((license_mgr.stato = funzionante & core.stato != guasto) -> AX copia_licenza = valida)  (atteso vero)
--     la luce non dipende dal License Manager:
--       CTLSPEC AG (license_mgr.stato = guasto -> !percorso_comando)                                        (atteso falso)
--     un License Manager compromesso puo' disattivare un modulo regolarmente licenziato:
--       CTLSPEC EF (license_mgr.stato = compromesso & copia_licenza = valida & EX copia_licenza = scaduta)  (atteso vero)
--     e' il primo caso in cui compromesso ha un effetto diverso da guasto (parte sulla sicurezza)
